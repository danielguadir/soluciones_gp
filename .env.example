# ============================================
# ENTORNO DE CONFIGURACIÓN - REQUERIDAS
# ============================================
# Copiar este archivo a .env.local y completar los valores
# NUNCA hacer commit de .env.local (ya está en .gitignore)

# ============================================
# Base de Datos (CRÍTICA)
# ============================================
# PostgreSQL URL en Neon o provider elegido
# Formato: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/impulsogp

# ============================================
# Seguridad: JWT Secret (CRÍTICA)
# ============================================
# Token secreto para firmar JWTs
# Generar con: openssl rand -base64 32
# Mínimo 32 caracteres, alfanuméricos y símbolos
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# ============================================
# API Configuration
# ============================================
# URL pública del API
NEXT_PUBLIC_API_URL=https://www.impulsogp.com

# ============================================
# Google Maps (si se usa)
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# ============================================
# Features
# ============================================
NEXT_PUBLIC_ENABLE_MAPS=false
NEXT_PUBLIC_ENABLE_GEOLOCATION=false

# ============================================
# Environment
# ============================================
NODE_ENV=production

# ============================================
# Vercel Specific (automático en Vercel)
# ============================================
# VERCEL_URL se establece automáticamente

# ============================================
# Email Notification (Resend - Free Tier)
# ============================================
# API Key de Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Correo del administrador que recibe los mensajes de contacto
ADMIN_EMAIL=100guadir@gmail.com

# Remitente autorizado en Resend (ej. noreply@impulsogp.com)
# Si no tienes dominio verificado en Resend aún, usa onboarding@resend.dev para pruebas locales.
SENDER_EMAIL=noreply@impulsogp.com

